{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor", "helpers:pinGitHubActionDigests"],
  "ignorePresets": [":semanticPrefixFixDepsChoreOthers"],
  "timezone": "Asia/Tokyo",
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "3 days",
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "semanticCommitScope": "deps",
  "platformCommit": "enabled",
  "lockFileMaintenance": { "enabled": true },
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest", "lockFileMaintenance"],
      "automerge": true
    },
    { "matchUpdateTypes": ["major"], "automerge": false, "addLabels": ["major"] }
  ],
  "vulnerabilityAlerts": { "automerge": true }
}
